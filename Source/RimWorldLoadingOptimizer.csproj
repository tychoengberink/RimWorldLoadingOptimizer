<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RimWorldLoadingOptimizer</AssemblyName>
    <RootNamespace>RimWorldLoadingOptimizer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>../$(RwVersion)/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RwVersion)' == '1.6'">
    <TargetFramework>net472</TargetFramework>
    <FrameworkPathOverride>$(RimWorldManaged)</FrameworkPathOverride>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RwVersion)' != '1.6'">
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);RW17</DefineConstants>
    <DefineConstants Condition="'$(AllFeatures)' != 'true'">$(DefineConstants);NATIVE_ASSETS</DefineConstants>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(RwVersion)' == '1.6'">
    <Reference Include="mscorlib" HintPath="$(RimWorldManaged)/mscorlib.dll" Private="false" />
    <Reference Include="System" HintPath="$(RimWorldManaged)/System.dll" Private="false" />
    <Reference Include="System.Xml" HintPath="$(RimWorldManaged)/System.Xml.dll" Private="false" />
    <Reference Include="System.Core" HintPath="$(RimWorldManaged)/System.Core.dll" Private="false" />
    <Reference Include="netstandard" HintPath="$(RimWorldManaged)/netstandard.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(RimWorldManaged)/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(RimWorldManaged)/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(RimWorldManaged)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(RimWorldManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(RimWorldManaged)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="0PrepatcherAPI" HintPath="$(PrepatcherDll)" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(RwVersion)' != '1.6'">
    <Reference Include="UnityStubs" HintPath="$(RimWorldManaged)/UnityStubs.dll" Private="false" />
    <Reference Include="Waylith" HintPath="$(RimWorldManaged)/Waylith.dll" Private="false" />
    <Compile Remove="LoadFromFix.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldManaged)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(HarmonyDll)" Private="false" />
  </ItemGroup>
</Project>
